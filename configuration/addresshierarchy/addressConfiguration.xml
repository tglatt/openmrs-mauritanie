<addressConfiguration>

    <addressComponents>

        <addressComponent>
            <field>country</field>
            <nameMappings>
                <nameMapping code="en" name="Country"/>
                <nameMapping code="fr" name="Pays"/>
            </nameMappings>
            <sizeMappings>
                <sizeMapping code="full" size="40"/>
                <sizeMapping code="standard" size="40"/>
            </sizeMappings>
            <lineByLineFormat>4</lineByLineFormat>
            <elementDefault>Mauritanie</elementDefault>
        </addressComponent>

        <addressComponent>
            <field>stateProvince</field>
            <nameMappings>
                <nameMapping code="en" name="Wilaya"/>
                <nameMapping code="fr" name="Wilaya"/>
            </nameMappings>
            <sizeMappings>
                <sizeMapping code="full" size="40"/>
                <sizeMapping code="standard" size="40"/>
            </sizeMappings>
            <lineByLineFormat>3</lineByLineFormat>
        </addressComponent>

        <addressComponent>
            <field>countyDistrict</field>
            <nameMappings>
                <nameMapping code="en" name="Moughataa"/>
                <nameMapping code="fr" name="Moughataa"/>
            </nameMappings>
            <sizeMappings>
                <sizeMapping code="full" size="40"/>
                <sizeMapping code="standard" size="40"/>
            </sizeMappings>
            <lineByLineFormat>2</lineByLineFormat>
        </addressComponent>

        <addressComponent>
            <field>cityVillage</field>
            <nameMappings>
                <nameMapping code="en" name="Commune"/>
                <nameMapping code="fr" name="Commune"/>
            </nameMappings>
            <sizeMappings>
                <sizeMapping code="full" size="40"/>
                <sizeMapping code="standard" size="40"/>
            </sizeMappings>
            <lineByLineFormat>1</lineByLineFormat>
        </addressComponent>

        <addressComponent>
            <field>address1</field>
            <nameMappings>
                <nameMapping code="en" name="Address"/>
                <nameMapping code="fr" name="Adresse"/>
            </nameMappings>
            <sizeMappings>
                <sizeMapping code="full" size="60"/>
                <sizeMapping code="standard" size="60"/>
            </sizeMappings>
            <lineByLineFormat>1</lineByLineFormat>
        </addressComponent>

    </addressComponents>

    <elementDefaults>
        <elementDefault>
            <field>country</field>
            <defaultValue>Mauritanie</defaultValue>
        </elementDefault>
    </elementDefaults>

    <manualEntryEnabled>true</manualEntryEnabled>

    <addressHierarchyFile>
        <filename>addresshierarchy.csv</filename>
        <entryDelimiter>,</entryDelimiter>
        <identifierDelimiter>%</identifierDelimiter>
    </addressHierarchyFile>

</addressConfiguration>
